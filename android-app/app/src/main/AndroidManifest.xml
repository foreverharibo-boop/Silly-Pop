<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.sec.android.app.sbrowser" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_black"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_black_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SillyPop">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity
            android:name=".LauncherActivity"
            android:taskAffinity="com.foreverharibo.sillypop.launcher"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="true" />

        <activity-alias
            android:name=".BlackIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_black_round"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".WhiteIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_white_round"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".SillyPopReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.foreverharibo.sillypop.NOTIFY" />
                <action android:name="com.foreverharibo.sillypop.PING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
