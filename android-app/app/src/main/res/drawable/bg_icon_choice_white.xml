<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0F0EE" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#FFAAAAA5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/icon_white" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/icon_border" />
        </shape>
    </item>
</selector>
